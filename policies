    .policy-updated{font-size:.9rem;color:var(--gray);margin-top:22px!important}
    .policy-layout{display:grid;grid-template-columns:250px minmax(0,1fr);gap:38px;align-items:start;padding-top:55px;padding-bottom:80px}
    .policy-nav{position:sticky;top:105px;background:var(--warm-bg);border:1px solid var(--border);border-radius:var(--radius);padding:22px}
    .policy-nav h2{font-size:1.1rem;margin-bottom:14px}
    .policy-nav ul{list-style:none}
    .policy-nav li{margin:0 0 10px}
    .policy-nav a{color:var(--navy);font-weight:700;text-decoration:underline;text-decoration-color:transparent;text-underline-offset:4px}
    .policy-nav a:hover,.policy-nav a:focus{color:var(--orange);text-decoration-color:currentColor}
    .policy-content{min-width:0}
    .policy-section{scroll-margin-top:110px;padding:0 0 36px;margin:0 0 36px;border-bottom:1px solid var(--border)}
