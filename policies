    .policy-section h3{margin-top:24px}
    .policy-section p,.policy-section li{color:var(--gray)}
    .policy-section ul{padding-left:22px;margin:0 0 20px}
    .policy-section li{margin-bottom:8px}
    .policy-note{padding:18px 20px;background:var(--light-bg);border-left:4px solid var(--orange);border-radius:0 var(--radius) var(--radius) 0;margin:22px 0}
    .policy-note p{margin:0}
    .policy-section a{color:var(--navy);text-decoration:underline;overflow-wrap:anywhere}
    .policy-section a:hover{color:var(--orange)}
    @media(max-width:800px){.policy-layout{grid-template-columns:1fr;gap:28px;padding-top:32px}.policy-nav{position:static}.policy-nav ul{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px 16px}.policy-nav li{margin:0}.policy-hero{padding:48px 0 32px}}
    @media(max-width:480px){.policy-nav ul{grid-template-columns:1fr}.policy-section{padding-bottom:26px;margin-bottom:26px}}
  </style>
</head>
